{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atrium.local/capture-extension-message.schema.json",
  "title": "Atrium Capture extension message",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "capture.event" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "eventId", "occurredAt"],
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "click",
                "drag",
                "input",
                "manual",
                "navigate",
                "scroll",
                "select",
                "shortcut",
                "submit"
              ]
            },
            "eventId": { "type": "string", "format": "uuid" },
            "occurredAt": { "type": "string", "format": "date-time" },
            "shortcut": { "type": "string", "maxLength": 100 },
            "target": { "$ref": "#/$defs/target" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "recorder.command" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "commandId"],
          "properties": {
            "command": { "type": "string", "enum": ["start", "pause", "resume", "stop"] },
            "commandId": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "recorder.snapshot" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "recorder.content-state" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string", "format": "uri", "maxLength": 4096 } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "editor.command" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commandId", "command"],
          "properties": {
            "commandId": { "type": "string", "format": "uuid" },
            "command": { "$ref": "#/$defs/editorCommand" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "editor.finalize" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commandId"],
          "properties": {
            "commandId": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "editor.asset" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId"],
          "properties": { "assetId": { "type": "string", "format": "uuid" } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "publisher.snapshot" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "publisher.sign-in" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "publisher.sign-out" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "publisher.enqueue" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commandId"],
          "properties": {
            "commandId": { "type": "string", "format": "uuid" },
            "collectionId": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "publisher.retry" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId"],
          "properties": { "jobId": { "type": "string", "format": "uuid" } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "publisher.publish-internal" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId"],
          "properties": { "jobId": { "type": "string", "format": "uuid" } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "diagnostics.snapshot" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "diagnostics.clear-local-data" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmation"],
          "properties": {
            "confirmation": { "const": "DELETE_LOCAL_CAPTURE_DATA" }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "native-bridge.snapshot" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payload"],
      "properties": {
        "kind": { "const": "native-bridge.set-enabled" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    }
  ],
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "geometry"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": {
          "type": "string",
          "enum": ["arrow", "rectangle", "text", "highlight", "blur", "mosaic", "redaction"]
        },
        "geometry": { "$ref": "#/$defs/rect" },
        "arrowDirection": {
          "type": "string",
          "enum": ["up_right", "down_right", "up_left", "down_left"]
        },
        "text": { "type": "string", "maxLength": 1000 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "editorCommand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "begin_review" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title"],
          "properties": {
            "kind": { "const": "update_title" },
            "title": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "text"],
          "properties": {
            "kind": { "const": "update_instruction" },
            "stepId": { "type": "string", "format": "uuid" },
            "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "toIndex"],
          "properties": {
            "kind": { "const": "move_step" },
            "stepId": { "type": "string", "format": "uuid" },
            "toIndex": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId"],
          "properties": {
            "kind": { "const": "delete_step" },
            "stepId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "withStepId"],
          "properties": {
            "kind": { "const": "merge_step" },
            "stepId": { "type": "string", "format": "uuid" },
            "withStepId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "const": "insert_step" },
            "afterStepId": { "type": "string", "format": "uuid" },
            "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "crop"],
          "properties": {
            "kind": { "const": "set_crop" },
            "stepId": { "type": "string", "format": "uuid" },
            "crop": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "annotation"],
          "properties": {
            "kind": { "const": "add_annotation" },
            "stepId": { "type": "string", "format": "uuid" },
            "annotation": { "$ref": "#/$defs/annotation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId", "annotationId"],
          "properties": {
            "kind": { "const": "remove_annotation" },
            "stepId": { "type": "string", "format": "uuid" },
            "annotationId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId"],
          "properties": {
            "kind": { "const": "approve_step" },
            "stepId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "approve_clear_steps" } }
        }
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "width", "x", "y"],
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "width"],
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessibleName": { "type": "string", "maxLength": 500 },
        "bounds": { "$ref": "#/$defs/rect" },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["devicePixelRatio", "origin", "viewportCss"],
          "properties": {
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
            "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
            "pageTitle": { "type": "string", "maxLength": 500 },
            "path": { "type": "string", "maxLength": 2048 },
            "selectors": {
              "type": "array",
              "maxItems": 5,
              "items": { "type": "string", "maxLength": 1000 }
            },
            "viewportCss": { "$ref": "#/$defs/viewport" }
          }
        },
        "role": { "type": "string", "maxLength": 100 }
      }
    }
  }
}
