{
  "name": "@atrium-capture/browser-extension",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@atrium-capture/atrium-client": "workspace:*",
    "@atrium-capture/capture-core": "workspace:*",
    "@atrium-capture/contracts": "workspace:*",
    "@atrium-capture/editor-model": "workspace:*",
    "@atrium-capture/privacy": "workspace:*",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@wxt-dev/module-react": "1.2.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "wxt": "0.21.4"
  },
  "scripts": {
    "build": "bun run --cwd ../.. messages:check && wxt build -b chrome",
    "dev": "wxt -b chrome",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:extension": "bun run build && playwright test",
    "typecheck": "bun run --cwd ../.. messages:check && wxt prepare && tsc --noEmit",
    "zip": "ATRIUM_CAPTURE_STORE_UPLOAD=1 wxt build -b chrome && node ../../scripts/create-browser-archive.mjs"
  }
}
