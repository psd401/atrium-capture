{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "include": [
    ".wxt/**/*.d.ts",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
